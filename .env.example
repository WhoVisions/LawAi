# ============================================================================
# LexiCore Environment Configuration
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control!

# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL="postgresql://lexicore:dev_password@localhost:5432/lexicore_dev"

# PostgreSQL Direct Connection (for migrations)
POSTGRES_USER="lexicore"
POSTGRES_PASSWORD="dev_password"
POSTGRES_DB="lexicore_dev"

# ============================================================================
# REDIS / CACHE
# ============================================================================
REDIS_URL="redis://:dev_redis_password@localhost:6379"

# ============================================================================
# AUTHENTICATION
# ============================================================================
# Clerk (https://clerk.com)
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."

# JWT (generate with: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ============================================================================
# AI / OPENAI
# ============================================================================
# OpenAI API (https://platform.openai.com/api-keys)
OPENAI_API_KEY="sk-proj-..."
OPENAI_ORG_ID=""  # Optional

# AI Configuration
AI_MODEL_PRIMARY="gpt-4-turbo-preview"
AI_MODEL_CLASSIFICATION="gpt-3.5-turbo"
AI_MODEL_EMBEDDING="text-embedding-3-small"
AI_MAX_TOKENS_OUTPUT="1000"
AI_TEMPERATURE="0.7"

# Rate Limits (queries per hour)
AI_RATE_LIMIT_FREE="10"
AI_RATE_LIMIT_CITIZEN="100"
AI_RATE_LIMIT_PRELAW="500"
AI_RATE_LIMIT_BAR_PREP="1000"

# Budget Limits (cents per month)
AI_BUDGET_FREE="50"
AI_BUDGET_CITIZEN="500"
AI_BUDGET_PRELAW="2000"
AI_BUDGET_BAR_PREP="5000"

# ============================================================================
# PAYMENTS / STRIPE
# ============================================================================
# Stripe (https://stripe.com)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Product IDs
STRIPE_PRICE_CITIZEN="price_..."
STRIPE_PRICE_PRELAW="price_..."
STRIPE_PRICE_BAR_PREP="price_..."
STRIPE_PRICE_LAWYER_PRO="price_..."

# ============================================================================
# FILE STORAGE
# ============================================================================
# Cloudflare R2 or AWS S3
STORAGE_PROVIDER="r2"  # "r2" | "s3"
STORAGE_BUCKET="lexicore-documents"
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY="..."
STORAGE_SECRET_KEY="..."
STORAGE_PUBLIC_URL="https://files.lexicore.com"

# Upload Limits
MAX_FILE_SIZE_MB="10"
ALLOWED_FILE_TYPES="pdf,docx,txt,jpg,png"

# ============================================================================
# EMAIL
# ============================================================================
# Resend (https://resend.com) or SendGrid
EMAIL_PROVIDER="resend"
EMAIL_API_KEY="re_..."
EMAIL_FROM="noreply@lexicore.com"
EMAIL_FROM_NAME="LexiCore"

# ============================================================================
# MONITORING & LOGGING
# ============================================================================
# Sentry (https://sentry.io)
SENTRY_DSN="https://...@sentry.io/..."
SENTRY_ORG="lexicore"
SENTRY_PROJECT="lexicore-api"
SENTRY_AUTH_TOKEN="..."
NEXT_PUBLIC_SENTRY_DSN="https://...@sentry.io/..."

# LogLevel
LOG_LEVEL="info"  # "error" | "warn" | "info" | "debug"
LOG_FORMAT="json"  # "json" | "pretty"

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_LAWYER_MARKETPLACE="false"
ENABLE_BAR_PREP="true"
ENABLE_DOCUMENT_ANALYSIS="true"
ENABLE_REAL_TIME_CHAT="false"

# ============================================================================
# APPLICATION
# ============================================================================
NODE_ENV="development"  # "development" | "staging" | "production"
PORT="3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"

# CORS Origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Session
SESSION_SECRET="your-session-secret-change-this"
SESSION_MAX_AGE_DAYS="30"

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================
# Pexels (for stock images - optional)
PEXELS_API_KEY="..."

# NY Bar API (for attorney verification - if available)
NY_BAR_API_KEY="..."
NY_BAR_API_URL="..."

# ============================================================================
# DEVELOPMENT / TESTING
# ============================================================================
# Test Database (separate from dev)
TEST_DATABASE_URL="postgresql://lexicore:test_password@localhost:5432/lexicore_test"

# Playwright (E2E tests)
PLAYWRIGHT_BASE_URL="http://localhost:3000"
PLAYWRIGHT_HEADLESS="true"

# Seed Data
SEED_ADMIN_EMAIL="admin@lexicore.local"
SEED_ADMIN_PASSWORD="Admin123!@#"

# ============================================================================
# PRODUCTION ONLY
# ============================================================================
# (Uncomment and set for production deployments)

# DATABASE_POOL_SIZE="20"
# DATABASE_SSL="true"
# REDIS_TLS_ENABLED="true"

# # Rate Limiting
# GLOBAL_RATE_LIMIT_REQUESTS="1000"
# GLOBAL_RATE_LIMIT_WINDOW_MS="60000"

# # Security
# HELMET_ENABLED="true"
# CSRF_PROTECTION="true"

# # Performance
# ENABLE_COMPRESSION="true"
# CACHE_TTL_SECONDS="3600"

# ============================================================================
# NOTES
# ============================================================================
# - Never commit .env files with real credentials
# - Use different secrets for each environment
# - Rotate secrets regularly
# - Use secret management service in production (e.g., Fly.io secrets)
# - See docs/DEPLOYMENT.md for production configuration
